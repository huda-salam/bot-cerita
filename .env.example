# MVP default: OpenRouter free model
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter structured output mode:
# auto = use model capability metadata
# enabled = force JSON Schema structured outputs
# disabled = prompt + Pydantic parser fallback
OPENROUTER_STRUCTURED_OUTPUTS=auto

# MVP model baseline: one fixed free model for every agent.
# Official OpenRouter model slug:
# nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Debug LLM request/response capture. Keep disabled normally.
# When enabled, raw prompts, schemas, and model responses are written locally to LLM_LOG_DIR.
LLM_DEBUG=false
LLM_LOG_DIR=logs/llm

# Anthropic direct API (optional / retained for premium benchmarking)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local OpenAI-compatible endpoint (optional; Ollama default)
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Provider-neutral logical models. These map through MODEL_ALIASES in app/config.py.
DEFAULT_MODEL=story-writer
DIRECTOR_MODEL=story-director
PLANNER_MODEL=story-planner
WRITER_MODEL=story-writer
CRITIC_MODEL=story-critic
REWRITER_MODEL=story-writer
EXPERT_MODEL=story-expert
WHAT_IF_MODEL=story-ideas

# Previous Anthropic model configuration retained for later premium benchmark.
# Uncomment the aliases in app/config.py to switch back to Anthropic.
# story-director -> anthropic:claude-haiku-4-5
# story-planner  -> anthropic:claude-opus-5
# story-writer   -> anthropic:claude-sonnet-5
# story-critic   -> anthropic:claude-sonnet-5
# story-expert   -> anthropic:claude-sonnet-5
# story-ideas    -> anthropic:claude-sonnet-5

MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=180
CRITIC_THRESHOLD=80
MAX_REVISIONS=2
DATABASE_URL=sqlite:///./bot_cerita.db
