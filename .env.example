# Primary LLM provider: anthropic or openrouter
LLM_PROVIDER=anthropic

# Anthropic API (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional OpenRouter fallback / experimentation provider
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing
DEFAULT_MODEL=claude-sonnet-5
DIRECTOR_MODEL=claude-haiku-4-5
PLANNER_MODEL=claude-opus-5
WRITER_MODEL=claude-sonnet-5
CRITIC_MODEL=claude-sonnet-5
REWRITER_MODEL=claude-sonnet-5
EXPERT_MODEL=claude-sonnet-5
WHAT_IF_MODEL=claude-sonnet-5

CRITIC_THRESHOLD=80
MAX_REVISIONS=2
DATABASE_URL=sqlite:///./bot_cerita.db
