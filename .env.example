# Default LLM provider: anthropic, openrouter, or ollama
LLM_PROVIDER=anthropic

# Anthropic direct API
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local OpenAI-compatible endpoint (optional; Ollama default)
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Provider-neutral logical models. Each maps through MODEL_ALIASES.
DEFAULT_MODEL=story-writer
DIRECTOR_MODEL=story-director
PLANNER_MODEL=story-planner
WRITER_MODEL=story-writer
CRITIC_MODEL=story-critic
REWRITER_MODEL=story-writer
EXPERT_MODEL=story-expert
WHAT_IF_MODEL=story-ideas

# Optional JSON mapping, e.g.
# MODEL_ALIASES={"story-writer":"anthropic:claude-sonnet-5","story-critic":"openrouter:some/model"}

MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=180
CRITIC_THRESHOLD=80
MAX_REVISIONS=2
DATABASE_URL=sqlite:///./bot_cerita.db
